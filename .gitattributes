bin/** linguist-vendored
check_project_dependencies.py linguist-vendored
code_quality_checks.py linguist-vendored

# Auto detect text files and normalize line endings to CRLF
* text=auto eol=crlf

# Python files - UTF-8 without BOM
*.py text eol=crlf diff=python

# Configuration/Data files
*.json text eol=crlf
*.toml text eol=crlf
*.yml text eol=crlf
*.txt text eol=crlf
*.ini text eol=crlf
*.flake8 text eol=crlf
*.svg text eol=crlf

# Documentation
*.md text eol=crlf

# Scripts
*.spec text eol=crlf

# Binary files - no conversion
*.exe binary
*.dll binary
*.dylib binary
*.so binary
*.png binary
*.wav binary
*.ico binary
*.mmdb binary
